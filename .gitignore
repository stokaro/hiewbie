# Rust build outputs. Cargo.lock is intentionally tracked for this application.
/target/
**/target/
/dist/
/coverage/

# Local temporary editor artifacts.
*.swp
*.swo
*~
.DS_Store

# Runtime sessions and local binary workspaces must not become fixtures by accident.
/.hiewbie-local/

# Python development helpers.
__pycache__/
*.py[cod]

# Repository-owned agent skills override any user-level .agents ignore rule.
!/.agents/
!/.agents/skills/
!/.agents/skills/hiew-ux/
!/.agents/skills/hiew-ux/**
